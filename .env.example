# Supabase — dedicated project for Pythia
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# EVM Network & Treasury (Arc Testnet — Circle L1)
NEXT_PUBLIC_CHAIN=arc
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
AGENT_TREASURY_ADDRESS=
AGENT_TREASURY_PRIVATE_KEY=
# Optional: WalletConnect project ID for RainbowKit (if empty, injected wallets work out-of-the-box)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Gemini — used for retrieval embeddings (query/document vectors), not for
# generating the final answer. Generation itself runs through GenLayer.
GEMINI_API_KEY=

# GenLayer — Studio Next (Chain ID 61997, Consensus v0.6)
# Deployed Intelligent Contract for grounded synthesis and validator consensus.
GENLAYER_NETWORK=studioDevnet
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_CHAIN_NAME="GenLayer Studio Next"
GENLAYER_RELAYER_PRIVATE_KEY=
GENLAYER_CONTRACT_ADDRESS=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only HMAC key used to sign payment receipts.
RECEIPT_SIGNING_SECRET=
